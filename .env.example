# Copy to .env for local use; never commit real credentials.
# Node does not load this file automatically. From a built checkout:
#   node --env-file=.env dist/index.js
# Complete reference: docs/CONFIGURATION.md

# Required in all modes: separate BookStack API Token ID and Token Secret.
BOOKSTACK_BASE_URL=https://wiki.example.com
BOOKSTACK_TOKEN_ID=your-token-id
BOOKSTACK_TOKEN_SECRET=your-token-secret

# Writes in non-OAuth modes only. Keep the BookStack role read-only as well.
BOOKSTACK_ENABLE_WRITE=false
# BOOKSTACK_INSECURE_SKIP_TLS_VERIFY=false

# Transport: npm defaults to stdio; Docker defaults to HTTP on 0.0.0.0:8080.
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080
# MCP_HTTP_PATH=/mcp
# Hostnames only, no scheme or port. Include localhost for container healthchecks.
# MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,bookstack-mcp,mcp.example.com

# HTTP request limits: positive integer bytes, default 10 MiB.
# OAuth registration/token bodies have a fixed 64 KiB limit.
# All body reads have a fixed 30-second deadline.
# MCP_HTTP_MAX_BODY_BYTES=10485760
# BOOKSTACK_SESSION_IDLE_TTL_MS=1800000
# BOOKSTACK_MAX_SESSIONS=1000

# Opt-in HTTP credential overrides. Both headers must be supplied together;
# absent headers use the environment token. See the credential matrix.
# BOOKSTACK_ALLOW_REQUEST_CREDENTIALS=false

# HTTP image-source policies. URL hosts are denied unless explicitly listed;
# all redirects are checked. Stdio permits local files and HTTP(S) sources.
# BOOKSTACK_ALLOW_LOCAL_IMAGE_FILES=false
# BOOKSTACK_IMAGE_ALLOWED_HOSTS=images.example.com

# Outbound BookStack request limits (milliseconds, except concurrency).
# Retry budget includes queue time, attempts, and 429 backoff.
# Concurrency is process-wide per BookStack base URL, not a requests/sec limit.
# BOOKSTACK_TIMEOUT_MS=30000
# BOOKSTACK_RETRY_TIMEOUT_MS=60000
# BOOKSTACK_MAX_CONCURRENCY=4

# Public HTTP connector with Entra OAuth; see docs/SETUP.md before enabling.
# MCP_OAUTH_ENABLE=true
# MCP_SERVER_URL=https://mcp.example.com
# OAUTH_TENANT_ID=your-tenant-id
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_AUDIENCE=api://your-client-id
# OAUTH_SCOPES=openid profile offline_access api://your-client-id/.default
# OAUTH_WRITE_ROLE=Writer
# Optional separate write account; requires both values and the Entra role.
# BOOKSTACK_WRITE_TOKEN_ID=your-write-token-id
# BOOKSTACK_WRITE_TOKEN_SECRET=your-write-token-secret

# Optional OAuth broker state persistence. Does not share live MCP sessions;
# multiple HTTP replicas still need session affinity. Keep Redis private.
# REDIS_URL=redis://redis:6379
# REDIS_KEY_PREFIX=bookstack-mcp
